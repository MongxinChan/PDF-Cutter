{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF 裁纸台",
  "version": "../package.json",
  "identifier": "io.github.mongxin.pdfcutter",
  "build": {
    "beforeDevCommand": "npm run prepare:web",
    "beforeBuildCommand": "npm run prepare:web",
    "frontendDist": "../web-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "PDF 裁纸台",
      "width": 1280,
      "height": 860,
      "minWidth": 420,
      "minHeight": 560,
      "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "copyright": "Copyright © 2026 Mongxin",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "compression": "lzma", "languages": ["SimpChinese", "English"], "displayLanguageSelector": false }
    },
    "macOS": { "minimumSystemVersion": "10.13" }
  }
}
